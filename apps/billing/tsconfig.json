{
  "extends": "tsconfig/react.json",
  "compilerOptions": {
    "target": "esnext",
    "lib": ["esnext.array", "dom", "es2022"],
    "module": "esnext",
    "moduleResolution": "node",
    "sourceMap": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  "include": ["."],
  "exclude": ["vite.config.ts", "vitest.config.ts", "vitest.config.component-tests.ts"]
}
