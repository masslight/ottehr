{
  "name": "report-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Standalone studio for building and iterating on Ottehr ad hoc reports with Claude. Builds to a single HTML file.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:fast": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "shot": "node scripts/shot.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@codemirror/lang-javascript": "^6.2.2",
    "@codemirror/lang-json": "^6.0.1",
    "@uiw/react-codemirror": "^4.23.0",
    "diff": "^7.0.0",
    "react-markdown": "^9.0.0",
    "ui-components": "*",
    "utils": "*"
  },
  "devDependencies": {
    "@types/diff": "^6.0.0",
    "vite-plugin-singlefile": "^2.0.3"
  }
}
