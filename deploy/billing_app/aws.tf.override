terraform {
  required_providers {
    aws = {
      source = "hashicorp/aws"
    }
  }
}

provider "aws" {
  profile = var.aws_profile
}

module "infra" {
  count  = var.not_local_env_resource_count
  source = "./infra/aws"
  providers = {
    aws = aws
  }
  project_id                 = var.project_id
  billing_bucket_name        = var.billing_bucket_name
  billing_domain             = var.billing_domain
  billing_cert_domain        = var.billing_cert_domain
}

module "app_upload" {
  count  = var.not_local_env_resource_count
  source = "./app_upload/aws"
  providers = {
    aws = aws
  }
  billing_bucket_id                  = one(module.infra[*].billing_bucket_id)
  billing_cdn_distribution_id        = one(module.infra[*].billing_cdn_distribution_id)
  billing_hash                       = one(terraform_data.build_billing[*].id)
  # TODO: Remove when upgraded to TF 1.14
  aws_profile = var.aws_profile
}

locals {
  billing_cdn_domain = one(module.infra[*].billing_cdn_domain)
}

resource "oystehr_application" "OTTEHR_BILLING" {
  login_redirect_uri        = local.billing_login_redirect_uri
  allowed_callback_urls     = local.billing_allowed_urls.allowed_callback_urls
  allowed_logout_urls       = local.billing_allowed_urls.allowed_logout_urls
  allowed_web_origins_urls  = local.billing_allowed_urls.allowed_web_origins_urls
  allowed_cors_origins_urls = local.billing_allowed_urls.allowed_cors_origins_urls
}
