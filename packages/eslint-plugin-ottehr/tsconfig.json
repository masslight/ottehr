{
  "extends": "tsconfig/base.json",
  "compilerOptions": {
    // The rules are plain CommonJS so ESLint can require() them unbuilt; JSDoc types check them.
    "allowJs": true,
    "checkJs": true
  },
  "include": ["index.js", "rules", "test", "./*.mts"],
  // The rule tests' own TypeScript project.
  "exclude": ["test/fixtures"]
}
